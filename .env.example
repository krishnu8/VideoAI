# ─── Backend (set these in Railway dashboard) ──────────────────────────────
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=https://ollama.com/api
OLLAMA_API_KEY=your_ollama_cloud_token_here
OLLAMA_MODEL=qwen3.5:cloud

# Pexels API Key — used for BOTH stock videos AND stock photos
PEXELS_API_KEY=your_pexels_api_key_here

# Video orientation default (can be overridden per-request via API)
VIDEO_ORIENTATION=portrait
# Options: portrait (1080x1920 — Shorts/Reels/TikTok)
#          landscape (1920x1080 — YouTube/standard)

# CORS: set this to your Vercel frontend URL in production
CORS_ORIGINS=https://your-app.vercel.app
# For local dev: CORS_ORIGINS=http://localhost:3000

# Caption Styling (optional)
CAPTIONS_ENABLED=true
CAPTION_FONT_SIZE=100
CAPTION_FONT_COLOR=white
CAPTION_STROKE_WIDTH=3
CAPTION_STROKE_COLOR=black
CAPTION_POSITION=center
# Options: center, top, bottom, bottom_center, bottom_left, bottom_right
CAPTION_FONT_FACE=Arial-Bold

# ─── Frontend (set these in Vercel dashboard) ───────────────────────────────
NEXT_PUBLIC_API_URL=https://your-api.railway.app
# For local dev: NEXT_PUBLIC_API_URL=http://localhost:8000
